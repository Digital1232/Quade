# QUADE static site (replaces the old WordPress .htaccess)

DirectoryIndex index.html index.php
Options -Indexes
ErrorDocument 404 /404/index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Always use https (main domain only: portfolio.quadengg.com shares this folder's rules)
RewriteCond %{HTTP_HOST} ^(www\.)?quadengg\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Old WordPress image links -> same image in /assets/images/ (only if that file exists)
RewriteCond %{DOCUMENT_ROOT}/assets/images/$1 -f
RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/(.+)$ /assets/images/$1 [R=301,L]

# Old WordPress pages that no longer exist -> nearest page
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^(comments/)?feed/?$ / [R=301,L]
RewriteRule ^category/.*$ /2026/02/20/ai-in-quality-process-how-quade-automates-qc-for-millwork-drawings-and-work-orders-in-outsourced-millwork-engineering/ [R=301,L]
RewriteRule ^author/.*$ / [R=301,L]
RewriteRule ^2026/?$ /2026/02/20/ai-in-quality-process-how-quade-automates-qc-for-millwork-drawings-and-work-orders-in-outsourced-millwork-engineering/ [R=301,L]
RewriteRule ^contact-us/?$ /#contact_us [R=301,L,NE]

# Block the old WordPress admin / xmlrpc paths (they no longer exist)
RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php) - [R=404,L]

# Any other missing page on quadengg.com -> custom 404 page (404.php sends the 404 status).
# Limited to the main domain so portfolio.quadengg.com keeps its own 404 page.
RewriteCond %{HTTP_HOST} ^(www\.)?quadengg\.com$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /404.php [L]
</IfModule>

# Browser caching for images, video, css, js
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType video/mp4 "access plus 30 days"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>
